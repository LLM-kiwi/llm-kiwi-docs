{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LLM.kiwi free API docs and how to use",
  "description": "Free AI API — OpenAI-compatible chat completions. No credit card required. Get started in minutes.",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "banner": {
    "content": "[**Open Dashboard**](https://llm.kiwi/dashboard) — Create API keys, manage your account, and monitor usage.",
    "dismissible": true,
    "type": "info",
    "color": {
      "light": "#16A34A",
      "dark": "#15803D"
    }
  },
  "navigation": [
    {
      "group": "Getting Started",
      "icon": "rocket",
      "pages": [
        "index",
        "quickstart",
        "concepts",
        "glossary"
      ]
    },
    {
      "group": "Guides & Examples",
      "icon": "book-open",
      "pages": [
        "best-practices",
        "use-cases",
        "examples",
        "sdks"
      ]
    },
    {
      "group": "Reference",
      "icon": "code",
      "pages": [
        "models",
        "limits",
        "api-reference",
        "errors"
      ]
    },
    {
      "group": "Support",
      "icon": "circle-question",
      "pages": [
        "faq",
        "troubleshooting"
      ]
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://llm.kiwi/dashboard"
      },
      {
        "label": "Chat",
        "href": "https://chat.llm.kiwi"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://llm.kiwi/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "vscode"
    ],
    "display": "toc"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/LLMkiwi",
      "github": "https://github.com/LLM-kiwi",
      "linkedin": "https://linkedin.com/company/llm-kiwi"
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "metadata": {
    "timestamp": true
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "examples": {
      "prefill": false
    },
    "playground": {
      "display": "simple"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  }
}
