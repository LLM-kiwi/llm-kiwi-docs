{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LLM.kiwi documentation",
  "description": "Beginner-friendly documentation for the free OpenAI-compatible LLM.kiwi API, with secure setup, working examples, reference material, and troubleshooting.",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "concepts"
        ]
      },
      {
        "group": "Build with LLM.kiwi",
        "pages": [
          "models",
          "examples",
          "sdks",
          "use-cases",
          "best-practices"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference",
          "limits",
          "errors"
        ]
      },
      {
        "group": "Help and resources",
        "pages": [
          "troubleshooting",
          "glossary",
          "faq"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://llm.kiwi/dashboard"
      },
      {
        "label": "Chat",
        "href": "https://chat.llm.kiwi"
      },
      {
        "href": "https://github.com/LLM-kiwi",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://llm.kiwi/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "toc"
  },
  "metadata": {
    "timestamp": true
  },
  "markdown": {
    "schema": true
  },
  "styling": {
    "eyebrows": "section",
    "latex": false
  }
}
