{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LLM.kiwi documentation",
  "description": "Beginner-friendly documentation for the free OpenAI-compatible LLM.kiwi API, with secure setup, working examples, reference material, and troubleshooting.",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "banner": {
    "content": "[**Open Dashboard**](https://llm.kiwi/dashboard) — Create API keys, manage your account, and monitor usage.",
    "dismissible": true,
    "type": "info",
    "color": {
      "light": "#16A34A",
      "dark": "#15803D"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "LLM.kiwi docs",
        "icon": "book-open",
        "description": "Free OpenAI-compatible API documentation",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Build with LLM.kiwi",
            "icon": "code",
            "pages": [
              "models",
              "examples",
              "sdks",
              "use-cases",
              "best-practices"
            ]
          },
          {
            "group": "API reference",
            "icon": "brackets-curly",
            "pages": [
              "api-reference",
              "limits",
              "errors"
            ]
          },
          {
            "group": "Help and resources",
            "icon": "life-ring",
            "pages": [
              "troubleshooting",
              "glossary",
              "faq"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://llm.kiwi/dashboard"
      },
      {
        "label": "Chat",
        "href": "https://chat.llm.kiwi"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://llm.kiwi/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "vscode"
    ],
    "display": "toc"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/LLMkiwi",
      "github": "https://github.com/LLM-kiwi",
      "linkedin": "https://linkedin.com/company/llm-kiwi"
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "metadata": {
    "timestamp": true
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "examples": {
      "prefill": false
    },
    "playground": {
      "display": "simple"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  }
}
